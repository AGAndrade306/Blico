<?xml version="1.0" encoding="utf-8"?>
<!-- Nada do Blico sai do aparelho por backup na nuvem nem por cópia de celular para celular
     (Smart Switch): agentes, lugares, atividade, segredos e preferências ficam só aqui.
     No Android 12+, allowBackup="false" sozinho não desliga a cópia entre aparelhos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
